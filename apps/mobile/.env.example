# Copie para .env (que fica fora do git) e preencha a chave.
#
# Estes valores sao PUBLICOS por natureza: sao embutidos no aplicativo que
# qualquer pessoa baixa da loja. Quem protege os dados e o RLS no banco.
#
# O Supabase esta migrando das chaves JWT antigas (anon, comecando com "eyJ")
# para as novas chaves publicaveis (sb_publishable_...). O app aceita as duas;
# a nova tem preferencia. Basta preencher UMA delas.
#
# A chave `service_role` (ou `sb_secret_...`) NAO entra aqui, nem em lugar
# nenhum do aplicativo: ela ignora todas as regras de seguranca e vive apenas
# nas Edge Functions, configurada no painel do Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://ykdbdpdepkdtyxtcwwex.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-chave-publicavel
