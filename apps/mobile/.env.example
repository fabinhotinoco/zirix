# Copie para .env (que fica fora do git) e preencha a chave.
#
# Estes dois valores são PÚBLICOS por natureza: eles são embutidos no
# aplicativo que qualquer pessoa baixa da loja. Quem protege os dados é o RLS
# no banco, não o sigilo destes valores.
#
# A chave `service_role` NÃO entra aqui, nem em lugar nenhum do aplicativo.
# Ela ignora todas as regras de segurança e vive apenas nas Edge Functions,
# configurada no painel do Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://ykdbdpdepkdtyxtcwwex.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
