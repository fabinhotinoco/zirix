{
  "expo": {
    "name": "PescaVerticalAPP",
    "slug": "pescaverticalapp",
    "scheme": "pescaverticalapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pescavertical.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para registrar o ponto da captura na foto que você publicar.",
        "NSCameraUsageDescription": "Usamos a câmera para você fotografar suas capturas.",
        "NSPhotoLibraryUsageDescription": "Usamos suas fotos para você publicar capturas no aplicativo."
      }
    },
    "android": {
      "package": "com.pescavertical.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/72aa036d-59ed-44e4-a8df-086bd877d2db"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "72aa036d-59ed-44e4-a8df-086bd877d2db"
      }
    }
  }
}
