# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser commitado.
# Use SEMPRE credenciais de TESTE nesta fase. Nada de produção.

# --- Aplicação Marketplace (criada dentro da SUA conta Mercado Pago) ---
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Precisa ser exatamente a mesma URL cadastrada em "Redirect URI" na aplicação.
# Pode ser qualquer URL — só serve para o navegador cair nela com ?code=...
MP_REDIRECT_URI=https://example.com/callback

# --- Conta do GUIA, preenchida pelo oauth.mjs ---
MP_GUIA_ACCESS_TOKEN=
MP_GUIA_REFRESH_TOKEN=
MP_GUIA_USER_ID=

# --- Parâmetros da simulação (opcionais) ---
VALOR_TOTAL_CENTAVOS=100000
COMISSAO_PERCENTUAL=10
SINAL_PERCENTUAL=30

# --- Comprador de teste (opcional) ---
MP_EMAIL_COMPRADOR=
MP_CPF_COMPRADOR=

# --- Webhook (opcional; precisa ser URL pública, ex. ngrok) ---
MP_NOTIFICATION_URL=

# Guardado pelo split-test.mjs, usado pelo refund-test.mjs
MP_PAYMENT_ID=
